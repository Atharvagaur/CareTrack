# CareTrack client environment (Vite)
# Copy this file to .env and adjust the values. Never commit .env.

# Base URL of the CareTrack API
VITE_API_BASE_URL=http://localhost:5000/api

# false -> use the real backend API (default; requires the server running)
# true  -> use the bundled mock data for offline/local UI work
VITE_USE_MOCK_API=false
