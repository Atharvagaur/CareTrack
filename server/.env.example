# CareTrack server environment
# Copy this file to .env and adjust the values. Never commit .env.

# Port the API listens on
PORT=5000

# development | test | production
NODE_ENV=development

# Allowed CORS origin(s) - the Vite dev server(s), comma separated.
# Vite uses 5173 normally and 5174 when the first port is taken.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# MongoDB connection string (local database, no credentials)
MONGODB_URI=mongodb://127.0.0.1:27017/caretrack

# OpenRouter (AI issue summarization). Server-side only - never expose these
# to the frontend and never prefix them with VITE_. Leave blank to disable AI.
# Prefer a JSON/structured-output capable model so responses reliably match the
# required schema, e.g. google/gemma-4-31b-it:free,
# nvidia/nemotron-3-super-120b-a12b:free (supports structured outputs), or
# openai/gpt-4o-mini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
