# CareTrack server environment
# Copy this file to .env and adjust the values. Never commit .env.

# Port the API listens on
PORT=5000

# development | test | production
NODE_ENV=development

# Allowed CORS origin(s) - the Vite dev server(s), comma separated.
# Vite uses 5173 normally and 5174 when the first port is taken.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# MongoDB connection string (local database, no credentials)
MONGODB_URI=mongodb://127.0.0.1:27017/caretrack
